(library
 (name canary_lib)
 (wrapped false)
 (libraries
  unix
  base
  fmt
  cmdliner
  yaml
  yojson
  tola_std
  binding
  opam-core
  opam-format
  fpath
  str)
 (preprocess
  (pps ppx_string ppx_yojson_conv ppx_deriving.show ppx_deriving.eq)))

; Layered subdirectory organization (2026-05-31). Subdirs are
; physical-only — wrapped:false + include_subdirs:unqualified means every
; .ml in any subdir produces a flat top-level module (e.g.
; action/canary_action.ml → module Canary_action). Layers:
;
;   base/    Layer 0 — vocabulary: foundational types every other layer
;                      uses (lang, artifact_kind, runner_os, cmdline,
;                      location, distro, package_manager, pm_properties,
;                      action, version, output-path conventions). Pure
;                      data, no theory of its own. canary_lang is its
;                      own file so canary_store and canary_basic can
;                      both depend on it without a cycle.
;   surface/ Layer 1 — surface theory: the API-surface declaration types,
;                      the c1..c8 contracts (WHAT to check — canary_compat,
;                      canary_compat_run), and the mechanism catalogue (HOW
;                      each mechanism realizes the checks — which stages
;                      exist, where checking points lie —
;                      canary_mechanism_catalogue). Pure, no I/O beyond
;                      Yojson.from_file.
;   tool/    Layer 2 — real-world tool wrappers: per-PM drivers
;                      (canary_pm_{apt,brew,opam,pip}), inspector drivers
;                      that shell out to inspect_*.py
;                      (canary_artifact_{native,lang,source}), post-hoc
;                      diff (canary_inspect_diff), and build-tool +
;                      opam/pip command generators (canary_toolchain).
;   action/  Layer 3 — action graph (action, step, run, post, cache, key,
;                      compat action-integration).
;   backend/ Layer 4 — output renderers (GH Actions YAML, HTML, Mermaid).
;   test/    Layer 5 — framework self-tests.
;
; Sub-libraries opt out via their own dune:
;   projects/ → canary_projects (live project specs)
; (The retired legacy/ sub-library was moved to
;  doc/_legacy_code/ in commit 302f1b3.)
(include_subdirs unqualified)
