(library
 (name canary_lib)
 (wrapped false)
 (libraries
  unix
  base
  fmt
  cmdliner
  yaml
  yojson
  tola_std
  binding
  opam-core
  opam-format
  fpath
  str)
 (preprocess
  (pps ppx_string ppx_yojson_conv ppx_deriving.show)))

; Layered subdirectory organization (introduced 2026-05-29, refactored
; 2026-05-31 into a theory/execution split). Subdirs are physical-only —
; wrapped:false + include_subdirs:unqualified means every .ml in any
; subdir produces a flat top-level module (e.g. action/canary_action.ml
; → module Canary_action). Layers:
;
;   theory/  Layer 0 — pure: primitive types (artifact_kind, runner_os,
;                      location, distro, pm), surface-theory types
;                      (api, comparators), no I/O beyond Yojson.from_file
;   exec/    Layer 1 — execution: drives Python inspector scripts and
;                      generates build-tool / opam / pip commands
;                      (cmake/ninja/dune/cc/pip/opam_install)
;   pm/      Layer 2 — per-PM drivers (apt/brew/opam/pip presence checks
;                      and install commands)
;   action/  Layer 3 — action graph (rule, step, run, post, cache, key,
;                      compat action-integration)
;   backend/ Layer 4 — output renderers (GH Actions YAML, HTML, Mermaid)
;   test/    Layer 5 — framework self-tests
;
; Sub-libraries opt out via their own dune:
;   projects/ → canary_projects (live project specs)
;   legacy/   → canary_legacy   (parked pre-canary plumbing + example_sp)
(include_subdirs unqualified)
