%% view: probes
graph LR
    source_node@{ shape: docs, label: "source [1]" }
    headers_node@{ shape: docs, label: "headers" }
    lib_node@{ shape: docs, label: "lib [2]" }
    app_node@{ shape: docs, label: "app" }
    ocaml_binding_node@{ shape: docs, label: "ocaml binding [3]" }

    A_configure{{"configure"}}
    A_build_headers{{"build_headers"}}
    A_build_lib{{"build_lib"}}
    A_build_binding_ocaml{{"build_binding_ocaml"}}
    A_build_app_ocaml{{"build_app_ocaml"}}
    A_install_lib{{"install_lib"}}
    A_pack_binding_ocaml{{"pack_binding_ocaml"}}
    A_pack_lib{{"pack_lib"}}
    A_pack_app{{"pack_app"}}
    A_probe_binding_ocaml(["probe_binding_ocaml [5]"])
    A_probe_app_ocaml(["probe_app_ocaml [6]"])
    A_probe_lib(["probe_lib [7]"])
    A_probe_lib_inspect(["inspect_lib [8]"])
    A_fetch_binding_ocaml_inspect(["inspect_ocaml [4]"])

    source_node --> A_configure
    A_configure --> A_build_headers
    A_build_headers --> headers_node
    A_configure --> A_build_lib
    A_build_lib --> lib_node
    A_configure --> A_build_binding_ocaml
    headers_node -.->|headers| A_build_binding_ocaml
    lib_node -.->|link| A_build_binding_ocaml
    A_build_binding_ocaml --> ocaml_binding_node
    ocaml_binding_node --> A_build_app_ocaml
    lib_node -.->|link| A_build_app_ocaml
    A_build_app_ocaml --> app_node
    A_build_lib --> A_install_lib
    ocaml_binding_node --> A_pack_binding_ocaml
    lib_node --> A_pack_lib
    app_node --> A_pack_app
    ocaml_binding_node -->|test| A_probe_binding_ocaml
    lib_node -.->|runtime| A_probe_binding_ocaml
    app_node -->|test| A_probe_app_ocaml
    lib_node -.->|runtime| A_probe_app_ocaml
    lib_node -->|test| A_probe_lib
    A_probe_lib -.-> A_probe_lib_inspect
    ocaml_binding_node -.-> A_fetch_binding_ocaml_inspect

    classDef artifact fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    classDef action fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
    classDef st_done fill:#c8e6c9,stroke:#4caf50,stroke-width:3px
    classDef st_done_ctx fill:#e8f5e9,stroke:#a5d6a7,stroke-width:1.5px
    classDef st_expected_fail fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef st_failed fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef st_skipped fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray:5
    classDef st_nospec fill:#fafafa,stroke:#bdbdbd,stroke-dasharray:5
    class source_node,headers_node,lib_node,app_node,ocaml_binding_node artifact
    class A_configure st_nospec
    class A_build_headers st_nospec
    class A_build_lib st_nospec
    class A_build_binding_ocaml st_nospec
    class A_build_app_ocaml st_nospec
    class A_install_lib st_nospec
    class A_pack_binding_ocaml st_nospec
    class A_pack_lib st_nospec
    class A_pack_app st_nospec
    class A_probe_binding_ocaml st_done
    class A_probe_app_ocaml st_done
    class A_probe_lib st_done
    class A_probe_lib_inspect st_done
    class A_fetch_binding_ocaml_inspect st_done_ctx
