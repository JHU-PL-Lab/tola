%% view: full
graph LR
    subgraph source_sg ["source"]
      source_node@{ shape: doc, label: "source (scenario)" }
    end
    subgraph lib_sg ["lib"]
      lib_node@{ shape: doc, label: "lib (scenario)" }
    end
    subgraph ocaml_binding_sg ["ocaml binding"]
      ocaml_binding_node@{ shape: doc, label: "ocaml binding (scenario)" }
    end
    subgraph app_sg ["app"]
      app_node@{ shape: doc, label: "app" }
    end

    apt_store@{ shape: cyl, label: "apt" }
    git_store@{ shape: cyl, label: "git" }
    opam_store@{ shape: cyl, label: "opam" }

    A_fetch_source{{"fetch_source [1]"}}
    A_fetch_lib{{"fetch_lib [2]"}}
    A_fetch_binding_ocaml{{"fetch_binding_ocaml [3]"}}
    A_fetch_binding_ocaml_inspect(["inspect_ocaml [4]"])
    A_probe_binding_ocaml(["probe_binding_ocaml [5]"])
    A_probe_app_ocaml(["probe_app_ocaml [6]"])
    A_probe_lib(["probe_lib [7]"])
    A_probe_lib_inspect(["inspect_lib [8]"])

    git_store --> A_fetch_source --> source_node
    apt_store --> A_fetch_lib --> lib_node
    lib_node -->|test| A_probe_lib
    opam_store --> A_fetch_binding_ocaml --> ocaml_binding_node
    lib_node -.->|runtime| A_fetch_binding_ocaml
    ocaml_binding_node -->|test| A_probe_binding_ocaml
    lib_node -.->|runtime| A_probe_binding_ocaml
    app_node -->|test| A_probe_app_ocaml
    lib_node -.->|runtime| A_probe_app_ocaml
    A_fetch_binding_ocaml -.-> A_fetch_binding_ocaml_inspect
    A_probe_lib -.-> A_probe_lib_inspect

    classDef artifact fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    classDef store fill:#e8eaf6,stroke:#3f51b5,stroke-width:1.5px
    classDef st_done fill:#c8e6c9,stroke:#4caf50,stroke-width:3px
    classDef st_done_ctx fill:#e8f5e9,stroke:#a5d6a7,stroke-width:1.5px
    classDef st_expected_fail fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef st_failed fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef st_skipped fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray:5
    classDef st_nospec fill:#fafafa,stroke:#bdbdbd,stroke-dasharray:5
    class source_node,lib_node,ocaml_binding_node artifact
    class apt_store store
    class git_store store
    class opam_store store
    class A_fetch_source st_done
    class A_fetch_lib st_done
    class A_fetch_binding_ocaml st_done
    class A_fetch_binding_ocaml_inspect st_done
    class A_probe_binding_ocaml st_done
    class A_probe_app_ocaml st_done
    class A_probe_lib st_done
    class A_probe_lib_inspect st_done
    linkStyle 0 stroke:#4caf50,stroke-width:3px
    linkStyle 1 stroke:#4caf50,stroke-width:3px
    linkStyle 2 stroke:#4caf50,stroke-width:3px
    linkStyle 3 stroke:#4caf50,stroke-width:3px
    linkStyle 4 stroke:#4caf50,stroke-width:3px
    linkStyle 5 stroke:#4caf50,stroke-width:3px
    linkStyle 6 stroke:#4caf50,stroke-width:3px
    linkStyle 7 stroke:#4caf50,stroke-width:3px
    linkStyle 8 stroke:#4caf50,stroke-width:3px
    linkStyle 9 stroke:#4caf50,stroke-width:3px
    linkStyle 10 stroke:#4caf50,stroke-width:3px
