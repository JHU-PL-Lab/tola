# System files
.DS_Store

_*

# docs/ is tracked for GitHub Pages: the overview page, its per-machine runs
# files, and three pointers under canary/projects/. Nothing a run writes is
# copied there since 2026-09-28, so the ignores that filtered those copies
# (step markers, pack repos, per-project run dirs, probe binaries) went too.
!docs/
!docs/**

!__init__.py

CMakeLists.txt

# quarto build
pkgm_files
build

# Local dev symlinks (absolute paths, not portable)
vendor/z3_dev

# Tiny example — track intentional underscore-prefixed sources
# (Python convention for "private" modules) and the cmake build file.
!canary/examples/tiny/c/CMakeLists.txt
!canary/examples/tiny/python_cext/tiny_cext/_native.c
!canary/examples/tiny/python_ctypes/tiny_ctypes/_raw.py
!canary/examples/tiny/scenarios/_harness/
!canary/examples/tiny/scenarios/_harness/**

# setuptools-generated metadata
*.egg-info

vendor/tola-m3

# Generated opam files (opam config subst of the .in templates)
canary/templates/opam-local-repo/packages/*/*/opam
