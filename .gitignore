# System files
.DS_Store

_*

# docs/ is tracked for GitHub Pages — web-viewable files only.
!docs/
!docs/**
docs/**/*.ok
docs/**/pack-repo/
docs/**/*_example*
# tiny / tiny-full are the framework's OWN test project — their per-run output
# (hundreds of per-scenario JSON/log files) is churn, not published diagrams.
docs/canary/projects/tiny/
docs/canary/projects/tiny-full/

!__init__.py

CMakeLists.txt

# quarto build
pkgm_files
build

# Local dev symlinks (absolute paths, not portable)
vendor/z3_dev

# Tiny example — track intentional underscore-prefixed sources
# (Python convention for "private" modules) and the cmake build file.
!canary/examples/tiny/c/CMakeLists.txt
!canary/examples/tiny/python_cext/tiny_cext/_native.c
!canary/examples/tiny/python_ctypes/tiny_ctypes/_raw.py
!canary/examples/tiny/scenarios/_harness/
!canary/examples/tiny/scenarios/_harness/**

# setuptools-generated metadata
*.egg-info/