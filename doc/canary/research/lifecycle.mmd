%% Foundational picture: native side vs. language side, aligned by layer.
%%
%% Each side is one subgraph with its full pipeline stacked
%% top-to-bottom. Horizontal lines between the two subgraphs are the
%% surface-theory contracts at each layer — "belief on the language
%% side must match appearance on the native side."
%%
%% Native side = blue = semantic (what the binary actually presents,
%% extractable by nm / readelf / runtime trace).
%% Language side = yellow = syntactic (what the binding source or
%% linker recorded, declarative).
flowchart TB
    subgraph NATIVE["Native side &nbsp;—&nbsp; appearance (semantic)"]
        direction TB
        n_src["C source repo"]
        n_type["z3.h declares<br/>Z3_mk_int(int) → int"]
        n_sym["libz3.so exports<br/>'Z3_mk_int' &nbsp;<br/><i>(nm -D)</i>"]
        n_abi["libz3.so dynamic section<br/>SONAME = libz3.so.4<br/><i>(readelf -d)</i>"]
        n_beh["native call:<br/>Z3_mk_int(5) ↝ Z3_ast"]
        n_src --> n_type --> n_sym --> n_abi --> n_beh
    end

    subgraph LANG["Language side &nbsp;—&nbsp; belief (syntactic)"]
        direction TB
        l_src["binding source repo<br/>stubs.c + .mli"]
        l_type[".mli external decl:<br/>z3_mk_int : int → int"]
        l_sym["binding artifact:<br/>link-time req 'Z3_mk_int'<br/><i>(stub references)</i>"]
        l_abi["binding ELF:<br/>NEEDED libz3.so.4<br/><i>(linker recorded)</i>"]
        l_beh["language wrapper:<br/>Z3.mk_int(5) ↝ Z3.ast<br/><i>(believed to preserve)</i>"]
        l_src --> l_type --> l_sym --> l_abi --> l_beh
    end

    %% Cross-side contracts (must match)
    n_type <-. "Type-match contract" .-> l_type
    n_sym <-. "Symbol-match contract" .-> l_sym
    n_abi <-. "ABI-match contract" .-> l_abi
    n_beh <-. "Behavior-match contract" .-> l_beh

    classDef semantic fill:#e8f4ff,stroke:#4a90c2
    classDef syntactic fill:#fff7e0,stroke:#d4a83b
    class n_src,n_type,n_sym,n_abi,n_beh semantic
    class l_src,l_type,l_sym,l_abi,l_beh syntactic
