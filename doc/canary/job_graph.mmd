%% Canary Job Graph
%% Node identity: { kind, name, origin, location, built_from }
%%   origin : location — where the artifact was made
%%   location : location — where it is now
%%   built_from : node option — immediate input dependency
%% Edge = operation that produces a node
%% Job = path from entry node(s) to a probe

graph TD
    %% ── Entry points ──
    %% n1: Lib "z3" origin=Build_tree location=Build_tree built_from=None
    SRC[n1: lib z3<br/>origin=Build_tree<br/>location=Build_tree]

    %% n2: Lib "z3" origin=System_pm location=System_pm built_from=None
    LIB_PM[n2: lib z3<br/>origin=System_pm<br/>location=System_pm]

    %% ── Compile binding ──
    %% n3a: Binding "z3" origin=Build_tree location=Build_tree built_from=n1
    SRC -->|compile binding| N3A[n3a: binding z3<br/>origin=Build_tree<br/>location=Build_tree<br/>built_from=n1]

    %% n3b: Binding "z3" origin=Build_tree location=Build_tree built_from=n2
    SRC -->|compile binding| N3B[n3b: binding z3<br/>origin=Build_tree<br/>location=Build_tree<br/>built_from=n2]
    LIB_PM -->|link against| N3B

    %% ── Package binding ──
    %% n4a: Package "z3" origin=Build_tree location=Lang_pm built_from=n3a
    N3A -->|package to opam| N4A[n4a: package z3<br/>origin=Build_tree<br/>location=Lang_pm<br/>built_from=n3a]

    %% n4b: Package "z3" origin=Build_tree location=Lang_pm built_from=n3b
    N3B -->|package to opam| N4B[n4b: package z3<br/>origin=Build_tree<br/>location=Lang_pm<br/>built_from=n3b]

    %% ── Fetch prebuilt package ──
    %% n5: Package "z3" origin=Lang_pm location=Lang_pm built_from=None
    LIB_PM -->|fetch prebuilt pkg| N5[n5: package z3<br/>origin=Lang_pm<br/>location=Lang_pm<br/>built_from=None]

    %% ── Probes ──
    N3A -->|probe| P1((probe))
    N3B -->|probe| P2((probe))
    N4A -->|probe| P3((probe))
    N4B -->|probe| P4((probe))
    N5  -->|probe| P5((probe))

    %% ── Jobs (paths) ──
    %% source-source:    n1 → n3a → P1
    %% prebuilt-source:  n2 → n3b → P2
    %% source-packaged:  n1 → n3a → n4a → P3
    %% prebuilt-packaged: n2 → n3b → n4b → P4
    %% prebuilt-prebuilt: n2 → n5 → P5

    %% ── Style ──
    classDef entry fill:#e8f5e9,stroke:#4caf50
    classDef built fill:#e3f2fd,stroke:#2196f3
    classDef pkg fill:#fff3e0,stroke:#ff9800
    classDef probe fill:#fce4ec,stroke:#e91e63

    class SRC,LIB_PM entry
    class N3A,N3B built
    class N4A,N4B,N5 pkg
    class P1,P2,P3,P4,P5 probe
